{
  "name": "expressts_template",
  "version": "1.0.0",
  "description": "expressjs typescript template",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --config ./nodemon.json src/index.ts",
    "build": "tsc",
    "buildstart": "npm run build && node build/index.js",
    "start": "tsc --noEmit && node --loader ts-node/esm/transpile-only src/index.ts",
    "starttsx": "tsc --noEmit && tsx src/index.ts",
    "prebuild": "test -f ./logs/app.log || mkdir -p ./logs && touch ./logs/app.log",
    "serve": "node build/index.js",
    "test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.10",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
